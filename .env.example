# ==============================================================================
# Personal WhatsApp Message Scheduler - Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Dashboard Authentication (Required)
# Set a strong, secure password to protect your WhatsApp QR code and message scheduler.
DASHBOARD_PASSWORD=ChangeThisPasswordImmediately!

# Express Session Encryption Secret (Required)
# Use a long, unpredictable random string (e.g. openssl rand -hex 32)
SESSION_SECRET=generate_a_random_32_character_secret_key_here

# Persistent Storage Directory
# SQLite database and WhatsApp LocalAuth browser tokens will be stored here.
# For Docker, this is mapped to a persistent volume (e.g. /app/data).
DATA_DIR=./data

# WhatsApp Authentication Strategy ('local' or 'remote')
# 'local'  - Uses LocalAuth with Chromium tokens saved inside DATA_DIR (recommended for VPS / Docker with persistent volumes).
# 'remote' - Uses RemoteAuth with durable external storage (e.g. MongoDB).
AUTH_STRATEGY=local

# MongoDB URI (Required only if AUTH_STRATEGY=remote)
# Example: mongodb+srv://user:password@cluster.mongodb.net/whatsapp_scheduler?retryWrites=true&w=majority
REMOTE_AUTH_MONGO_URI=

# Chromium / Puppeteer Settings
# In Docker or Linux VPS, point this to system Chromium (e.g. /usr/bin/chromium).
# Leave empty on Windows / macOS for Puppeteer's default or system-detected browser.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true

# Scheduler Rules & Timezone
TIMEZONE=Asia/Karachi
CHECK_INTERVAL_SECONDS=15
OVERDUE_WINDOW_MINUTES=15
